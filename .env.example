# Flask Settings
SECRET_KEY=your_secret_key_here

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
# REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Supported: openai, groq, gemini, nvidia, ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional Fallback Search Provider (teammates configure their own keys in UI)
# SEARCH_PROVIDER=serper
# SERPER_API_KEY=your_serper_key_here

# Email / SMTP (Optional for automated reporting)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
SENDER_NAME=Research Pipeline

# Zoho CRM Integration (Optional global default; teammates configure in UI)
# ZOHO_CLIENT_ID=...
# ZOHO_CLIENT_SECRET=...
# ZOHO_REFRESH_TOKEN=...
# ZOHO_API_DOMAIN=https://www.zohoapis.in
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
